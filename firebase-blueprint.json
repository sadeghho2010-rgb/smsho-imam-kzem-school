{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "A student in the system.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nationalId": { "type": "string" },
        "isActive": { "type": "boolean" },
        "phoneNumber": { "type": "string" },
        "grade": { "type": "string" },
        "fatherOccupation": { "type": "string" },
        "birthPlace": { "type": "string" },
        "birthDate": { "type": "string" },
        "maritalStatus": { "type": "string", "enum": ["مجرد", "متاهل"] },
        "livingStatus": { "type": "string", "enum": ["پدری", "خوابگاه", "اجاره ای", "شخصی", "سایر"] },
        "livingStatusOther": { "type": "string" },
        "classicEducation": { "type": "string" },
        "howzaEntryYear": { "type": "string" },
        "levelOneSchool": { "type": "string" },
        "tammomStatus": { "type": "string", "enum": ["معمم", "غیر معمم"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "isActive"]
    },
    "Program": {
      "title": "Program",
      "description": "A school program or class.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["main", "counseling", "thursday", "research"] },
        "day": { "type": "string" },
        "time": { "type": "string" },
        "teacher": { "type": "string" }
      },
      "required": ["title", "type"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "Linking a student to a program.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "programId": { "type": "string" }
      },
      "required": ["studentId", "programId"]
    },
    "ResearchRecord": {
      "title": "ResearchRecord",
      "description": "Research progress for a student.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "stage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "stage"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Teacher feedback for a student.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "author": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["previous_grade", "advisor", "shahpouri", "fiqh", "usul", "custom", "psychology", "grade_teacher"] },
        "importance": { "type": "string", "enum": ["low", "medium", "high"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "author", "content", "type", "importance"]
    },
    "OralExam": {
      "title": "OralExam",
      "description": "Oral exam score and feedback.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "score": { "type": "number" },
        "feedback": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "score"]
    },
    "ConversationArchive": {
      "title": "ConversationArchive",
      "description": "Archive of talks with a student.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "summary": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "summary"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Attendance log for a student.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["present", "absent", "late"] },
        "reason": { "type": "string" }
      },
      "required": ["studentId", "date", "status"]
    },
    "StudyStat": {
      "title": "StudyStat",
      "description": "Study and discussion statistics.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "studyHours": { "type": "number" },
        "discussionHours": { "type": "number" }
      },
      "required": ["studentId", "date"]
    },
    "Todo": {
      "title": "Todo",
      "description": "A task to follow up on.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "title": { "type": "string" },
        "completed": { "type": "boolean" },
        "dueDate": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "completed"]
    }
  },
  "firestore": {
    "/students/{studentId}": { "schema": "Student", "description": "Collection of students." },
    "/programs/{programId}": { "schema": "Program", "description": "Collection of school programs." },
    "/enrollments/{enrollmentId}": { "schema": "Enrollment", "description": "Mapping students to programs." },
    "/research_records/{recordId}": { "schema": "ResearchRecord", "description": "Research progress records." },
    "/comments/{commentId}": { "schema": "Comment", "description": "Teacher comments." },
    "/oral_exams/{examId}": { "schema": "OralExam", "description": "Oral exam records." },
    "/conversation_archives/{archiveId}": { "schema": "ConversationArchive", "description": "Archive of talks." },
    "/attendance/{attendanceId}": { "schema": "Attendance", "description": "Attendance logs." },
    "/study_stats/{statId}": { "schema": "StudyStat", "description": "Study statistics." },
    "/todos/{todoId}": { "schema": "Todo", "description": "To-do items." }
  }
}
